  "rules": [
    {
      "pattern": "^FinePix X100\\b",
      "format": "APS-C",
      "sensorMm": [
        23.6,
        15.8
      ],
      "crop": 1.52,
      "note": "Original X100 (2011) writes \"FinePix X100\"; 12MP APS-C 23.6x15.8."
    },
    {
      "pattern": "^X100",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X100 line (X100S/T/F/V/VI and future X100 models) all use APS-C sensors (23.5-23.6 x 15.6-15.7 mm)."
    },
    {
      "pattern": "^X[- ]?(HF\\d|half)",
      "format": "1-inch",
      "sensorMm": [
        11.73,
        8.8
      ],
      "crop": 2.95,
      "note": "X half family (EXIF/marketing \"X half\", product code X-HF1): 1-inch sensor, 3:4 recorded area ~8.8x11.73 mm (crop 2.95 = Fujifilm 10.8 mm -> 32 mm equiv)."
    },
    {
      "pattern": "^X[- ]?H\\d",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X-H flagship bodies (X-H1, X-H2, X-H2S, successors): APS-C X-Trans."
    },
    {
      "pattern": "^X[- ]?Pro ?\\d",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X-Pro rangefinder-style bodies: APS-C."
    },
    {
      "pattern": "^X[- ]?T\\d",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X-T SLR-style bodies (X-T1..X-T6, X-T10..X-T50, X-T100/200, X-T30 II/III): APS-C."
    },
    {
      "pattern": "^X[- ]?E\\d",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X-E rangefinder-style bodies: APS-C."
    },
    {
      "pattern": "^X[- ]?S\\d{2}",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X-S10/X-S20 and successors: APS-C (checked before the 2/3\" X-S1 rule)."
    },
    {
      "pattern": "^X[- ]?S\\d\\s*$",
      "format": "2/3\"",
      "sensorMm": [
        8.8,
        6.6
      ],
      "crop": 3.93,
      "note": "X-S1 (2011) is a 2/3\" EXR-CMOS superzoom bridge, not APS-C."
    },
    {
      "pattern": "^X[- ]?A\\d",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.7
      ],
      "crop": 1.53,
      "note": "X-A entry bodies: APS-C Bayer CMOS."
    },
    {
      "pattern": "^X[- ]?M\\d",
      "format": "APS-C",
      "sensorMm": [
        23.5,
        15.6
      ],
      "crop": 1.53,
      "note": "X-M compact bodies (X-M1, X-M5): APS-C."
    },
    {
      "pattern": "^X[1-3]0\\s*$",
      "format": "2/3\"",
      "sensorMm": [
        8.8,
        6.6
      ],
      "crop": 3.93,
      "note": "X10/X20/X30 premium compacts: 2/3\" sensor."
    },
    {
      "pattern": "^X[7-9]0\\s*$",
      "format": "APS-C",
      "sensorMm": [
        23.6,
        15.6
