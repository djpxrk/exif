    },
    {
      "pattern": "^(Canon )?EOS[- ]?1D[- ]?[XC]\\b",
      "format": "Full frame",
      "sensorMm": [
        36,
        24
      ],
      "crop": 1,
      "note": "EOS-1D X / 1D C family (1D X, 1D C, 1D X Mark II/III and any later 1D X) are full frame."
    },
    {
      "pattern": "^(Canon )?EOS[- ]?1D Mark III\\b",
      "format": "APS-H",
      "sensorMm": [
        28.1,
        18.7
