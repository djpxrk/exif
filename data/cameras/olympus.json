  "rules": [
    {
      "pattern": "^(OLYMPUS )?(OM-?D )?E-?M ?\\d",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "OM-D E-M1 / E-M5 / E-M10 bodies incl. MarkII/III/IV, X and IIIS variants; all Micro Four Thirds"
    },
    {
      "pattern": "^(OM ?SYSTEM |OLYMPUS )?OM-?\\d",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "OM SYSTEM OM-1 / OM-3 / OM-5 bodies (incl. MarkII, IR) and future OM-n models; Micro Four Thirds"
    },
    {
      "pattern": "^(OLYMPUS )?(PEN )?E-?P ?\\d",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "PEN E-P series (E-P1..E-P7 and successors); Micro Four Thirds"
    },
    {
      "pattern": "^(OLYMPUS )?(PEN )?(Lite |Mini )?E-?P[LM] ?\\d",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "PEN Lite E-PL and PEN Mini E-PM series; Micro Four Thirds"
    },
    {
      "pattern": "^PEN-?F\\b",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "PEN-F (and a possible PEN-F II); Micro Four Thirds"
    },
    {
      "pattern": "^(OM ?SYSTEM |OLYMPUS )?PEN\\b",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "Any PEN-named body, incl. the 2026 OM SYSTEM PEN (20.4MP 4/3 Live MOS) whose EXIF Model string is not yet confirmed; does not match PENTAX"
    },
    {
      "pattern": "^AIR-?A\\d",
      "format": "Micro Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "Olympus Air lens-style camera; Micro Four Thirds"
    },
    {
      "pattern": "^E-(10|20)\\b",
      "format": "2/3\"",
      "sensorMm": [
        8.8,
        6.6
      ],
      "crop": 3.93,
      "note": "E-10 / E-20 fixed-lens prosumer SLRs (pre-Four Thirds) use a 2/3-inch CCD"
    },
    {
      "pattern": "^E-(?!10\\b|20\\b|100\\b)\\d{1,3}\\b",
      "format": "Four Thirds",
      "sensorMm": [
        17.3,
        13
      ],
      "crop": 2,
      "note": "Four Thirds DSLRs: E-1, E-3, E-5, E-30, E-300..E-620 (excludes E-10/E-20 2/3-inch and E-100RS 1/2-inch)"
    },
    {
      "pattern": "^STYLUS ?1s?\\b",
      "format": "1/1.7\"",
      "sensorMm": [
        7.44,
        5.58
      ],
      "crop": 4.65,
