  "rules": [
    {
      "pattern": "^(?:Canon )?EOS R(?:7|\\d{2,3})(?:m\\d+)?(?:\\s|$)",
      "format": "APS-C (Canon)",
      "sensorMm": [
        22.3,
        14.9
      ],
      "crop": 1.61,
      "note": "RF-mount APS-C bodies: R7 and any two/three-digit R model (R10, R50, R50 V, R100 and future Mark II / mN variants such as \"R7 Mark II\" or \"R50m2\")."
    },
    {
      "pattern": "^(?:Canon )?EOS R(?:a|p|[1-689])?(?:m\\d+)?(?:\\s|$)",
      "format": "Full frame",
      "sensorMm": [
        36,
        24
      ],
      "crop": 1,
      "note": "RF-mount full-frame bodies: EOS R, Ra, RP and single-digit models (R1, R3, R5, R5 C, R6, R8) incl. \"Mark N\", \"mN\" and suffixed (V, C) variants."
    },
    {
      "pattern": "^(?:Canon )?EOS (?:Kiss )?M\\d*(?:m\\d+)?(?:\\s|$)",
      "format": "APS-C (Canon)",
      "sensorMm": [
        22.3,
        14.9
      ],
      "crop": 1.61,
      "note": "EF-M mount EOS M family incl. regional EOS Kiss M / Kiss M2 and \"M50m2\"-style Mark II strings; every EOS M body uses a ~22.3x14.9 mm APS-C sensor."
    },
    {
      "pattern": "^(?:Canon )?EOS C50(?:\\s|$)",
      "format": "Full frame",
      "sensorMm": [
        36,
        24
      ],
      "crop": 1,
      "note": "Cinema EOS C50 (RF mount, full-frame 7K sensor; can record stills)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot G1 ?X ?(?:Mark ?|Mk ?|M)?(?:III|3)\\b",
      "format": "APS-C (Canon)",
      "sensorMm": [
        22.3,
        14.9
      ],
      "crop": 1.61,
      "note": "G1 X Mark III uses a 24 MP APS-C sensor (same class as EOS M)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot G1 ?X ?(?:Mark ?|Mk ?|M)?(?:II|2)\\b",
      "format": "1.5\" (multi-aspect, 3:2 area)",
      "sensorMm": [
        18.7,
        12.5
      ],
      "crop": 1.92,
      "note": "G1 X Mark II: 1.5-type multi-aspect sensor; 3:2 image area ~18.7x12.5 mm (lens 12.5 mm = 24 mm equiv)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot G1 ?X",
      "format": "1.5\"",
      "sensorMm": [
        18.7,
        14
      ],
      "crop": 1.85,
      "note": "Original G1 X: 1.5-type 18.7x14.0 mm 4:3 sensor."
    },
    {
      "pattern": "^(?:Canon )?PowerShot G\\d+ ?X",
      "format": "1-inch",
      "sensorMm": [
        13.2,
        8.8
      ],
      "crop": 2.73,
      "note": "PowerShot G3 X / G5 X / G7 X / G9 X families (all marks) use 1-inch 13.2x8.8 mm sensors; covers future G-series X models."
    },
    {
      "pattern": "^(?:Canon )?PowerShot G(?:9|1[0-6])(?:\\s|$)",
      "format": "1/1.7\"",
      "sensorMm": [
        7.44,
        5.58
      ],
      "crop": 4.65,
      "note": "PowerShot G9-G16 (non-X) enthusiast compacts: 1/1.7\" sensor."
    },
    {
      "pattern": "^(?:Canon )?PowerShot G[1-7](?:\\s|$)",
      "format": "1/1.8\"",
      "sensorMm": [
        7.18,
        5.32
      ],
      "crop": 4.84,
      "note": "Early PowerShot G1-G7 (2000-2006): 1/1.8\" sensor."
    },
    {
      "pattern": "^(?:Canon )?PowerShot (?:S(?:9\\d|1[0-2]\\d|200)|N100)(?:\\s|$)",
      "format": "1/1.7\"",
      "sensorMm": [
        7.44,
        5.58
      ],
      "crop": 4.65,
      "note": "PowerShot S90/S95/S100/S110/S120, S200 (2014) and N100: 1/1.7\" sensor (note: the 2000-era Digital ELPH S100 and 2002 Digital ELPH S200 also wrote \"PowerShot S100\"/\"S200\" but used 1/2.7\" sensors and are rare)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot S(?:[2-8]0|45|4[01]0|500)(?:\\s|$)",
      "format": "1/1.8\"",
      "sensorMm": [
        7.18,
        5.32
      ],
      "crop": 4.84,
      "note": "PowerShot S20-S80 (incl. S45) and Digital ELPH S400/S410/S500 (2000-2005): 1/1.8\" CCD (digicamdb/DPReview 7.1 mm wide)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot S[2-5] IS",
      "format": "1/2.5\"",
      "sensorMm": [
        5.76,
        4.29
      ],
      "crop": 6.02,
      "note": "PowerShot S2 IS / S3 IS / S5 IS superzooms: 1/2.5\" CCD (5.74 mm wide per digicamdb/DPReview)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot Pro1(?:\\s|$)",
      "format": "2/3\"",
      "sensorMm": [
        8.8,
        6.6
      ],
      "crop": 3.93,
      "note": "PowerShot Pro1 (2004): 2/3\" 8 MP CCD."
    },
    {
      "pattern": "^(?:Canon )?PowerShot V1(?:\\s|$)",
      "format": "1.4\"",
      "sensorMm": [
        18.4,
        12.3
      ],
      "crop": 1.96,
      "note": "PowerShot V1: 1.4-type 18.4x12.3 mm sensor."
    },
    {
      "pattern": "^(?:Canon )?PowerShot V\\d{2,}",
      "format": "1-inch",
      "sensorMm": [
        13.2,
        8.8
      ],
      "crop": 2.73,
      "note": "PowerShot V10 and later two-digit V models: 1-inch sensor."
    },
    {
      "pattern": "^(?:Canon )?PowerShot SX1[02]0 IS",
      "format": "1/2.5\"",
      "sensorMm": [
        5.76,
        4.29
      ],
      "crop": 6.02,
      "note": "SX100 IS / SX120 IS: 1/2.5\" CCD."
    },
    {
      "pattern": "^(?:Canon )?PowerShot SX\\d+",
      "format": "1/2.3\"",
      "sensorMm": [
        6.17,
        4.55
      ],
      "crop": 5.64,
      "note": "PowerShot SX superzoom / travel-zoom line: 1/2.3\" sensor (vast majority of models)."
    },
    {
      "pattern": "^(?:Canon )?PowerShot ZOOM",
      "format": "1/3\"",
      "sensorMm": [
        4.8,
        3.6
      ],
      "crop": 7.21,
      "note": "PowerShot ZOOM monocular camera: 1/3\" sensor."
    },
    {
      "pattern": "^(?:Canon )?(?:PowerShot (?:ELPH|SD|A|D|N|PICK)|(?:DIGITAL )?IXUS|IXY)",
      "format": "1/2.3\"",
      "sensorMm": [
        6.17,
        4.55
      ],
      "crop": 5.64,
      "note": "Approximate fallback: IXUS / ELPH / IXY / A / D-series point-and-shoots mostly use 1/2.3\" sensors (older ones 1/2.5\"-1/1.8\"); low confidence."
    },
    {
      "pattern": "^(?:Canon )?PowerShot",
      "format": "1/2.3\"",
      "sensorMm": [
        6.17,
        4.55
      ],
      "crop": 5.64,
      "note": "Last-resort fallback for unknown PowerShot models: 1/2.3\" (most common PowerShot sensor); low confidence."
    }
  ]
}
