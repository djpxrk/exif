    {
      "brand": "SIGMA",
      "pattern": "^(SIGMA )?fp L$",
      "format": "Full frame",
      "sensorMm": [
        36,
        24
      ],
      "crop": 1,
      "note": "SIGMA fp L (61MP full frame); must precede plain fp rule"
    },
    {
      "brand": "SIGMA",
      "pattern": "^(SIGMA )?fp( \\S+)?$",
      "format": "Full frame",
      "sensorMm": [
        35.9,
        23.9
      ],
      "crop": 1,
      "note": "SIGMA fp family (24.6MP full frame); also catches future fp variants"
    },
    {
      "brand": "SIGMA",
      "pattern": "^(SIGMA )?BF( \\S+)?$",
      "format": "Full frame",
      "sensorMm": [
        35.9,
        23.9
      ],
      "crop": 1,
      "note": "SIGMA BF (full frame); some files write Make/Model as \"Sigma\"/\"Sigma BF\""
    },
